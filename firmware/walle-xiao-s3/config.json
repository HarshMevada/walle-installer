{
    "type": "walle-xiao-s3",
    "target": "esp32s3",
    "builds": [
        {
            "name": "walle-xiao-s3",
            "build_options": {
                "camera_hmirror": false,
                "camera_vflip": false
            },
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_WALLE_XIAO_S3=y",
                "CONFIG_OLED_SH1106_128X64=y",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"main/boards/walle-xiao-s3/partitions.csv\""
            ]
        }
    ]
}